---
import productsData from '../content/products.json';
import siteData from '../content/site.json';

const buildWhatsAppUrl = (productName: string) => {
  const phone = siteData.whatsapp.replace(/[^\d]/g, '');
  const message = encodeURIComponent(`Hola Café Cenit, quiero pedir el ${productName}.`);
  return `https://wa.me/${phone}?text=${message}`;
};
---

<section
  id="cafes"
  class="section-y"
  style="background-color: var(--color-bg-cream);"
>
  <div class="container-cenit">
    <div class="text-center mb-12 md:mb-16 reveal">
      <span
        class="inline-block text-xs font-semibold uppercase tracking-widest mb-3"
        style="color: var(--color-ember-600);"
      >
        Nuestros cafés
      </span>
      <h2
        class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold max-w-3xl mx-auto mb-4"
        style="color: var(--color-roast-900);"
      >
        Tres perfiles, un mismo cuidado
      </h2>
      <p
        class="text-lg max-w-2xl mx-auto"
        style="color: var(--color-roast-700);"
      >
        Elegí el que va con tu momento. Todos son del mismo origen,
        la diferencia está en el tueste.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-6 md:gap-8">
      {productsData.products.map((product, idx) => (
        <article
          class="reveal flex flex-col p-8 md:p-10 rounded-2xl border transition-all hover:-translate-y-1 hover:shadow-xl"
          style={`background-color: var(--color-bg-paper); border-color: var(--color-roast-100); ${idx === 1 ? 'transform: scale(1.02); box-shadow: 0 10px 25px -5px rgba(217, 119, 66, 0.15);' : ''}`}
        >
          {idx === 1 && (
            <span
              class="self-start mb-4 px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-full"
              style="background-color: var(--color-ember-500); color: white;"
            >
              Más pedido
            </span>
          )}

          <div class="text-5xl mb-4" aria-hidden="true">{product.icon}</div>

          <h3
            class="text-2xl md:text-3xl font-heading font-bold mb-2"
            style="color: var(--color-roast-900);"
          >
            {product.name}
          </h3>

          <p
            class="text-sm italic mb-4"
            style="color: var(--color-roast-500);"
          >
            {product.tagline}
          </p>

          <p
            class="text-base leading-relaxed mb-6"
            style="color: var(--color-roast-700);"
          >
            {product.description}
          </p>

          <div class="mb-6">
            <h4
              class="text-xs font-bold uppercase tracking-wider mb-3"
              style="color: var(--color-roast-500);"
            >
              Notas de cata
            </h4>
            <ul class="flex flex-wrap gap-2">
              {product.notes.map((note) => (
                <li
                  class="px-3 py-1 text-xs font-medium rounded-full"
                  style="background-color: var(--color-cream-soft); color: var(--color-roast-700);"
                >
                  {note}
                </li>
              ))}
            </ul>
          </div>

          <div
            class="text-xs space-y-1 mb-6 pb-6 border-b"
            style="color: var(--color-roast-500); border-color: var(--color-roast-100);"
          >
            <p><span class="font-semibold">Origen:</span> {product.origin}</p>
            <p><span class="font-semibold">Tueste:</span> {product.roast_level}</p>
            <p><span class="font-semibold">Ideal para:</span> {product.best_for}</p>
            <p><span class="font-semibold">Presentación:</span> {product.weight}</p>
          </div>

          <div class="mt-auto">
            <div class="flex items-baseline gap-2 mb-5">
              <span
                class="text-3xl md:text-4xl font-heading font-bold"
                style="color: var(--color-roast-900);"
                data-price-usd={product.priceUSD}
              >
                ${product.priceUSD} USD
              </span>
              <span class="text-xs" style="color: var(--color-roast-500);">/ {product.weight}</span>
            </div>

            <a
              href={buildWhatsAppUrl(product.name)}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center gap-2 w-full px-6 py-3.5 text-sm font-semibold rounded-full transition-all hover:-translate-y-0.5 shadow-md hover:shadow-lg"
              style="background-color: var(--color-ember-500); color: white;"
              aria-label={`Pedir ${product.name} por WhatsApp`}
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
              Pedir este
            </a>
          </div>
        </article>
      ))}
    </div>

    <p
      class="text-center text-xs mt-8 italic"
      style="color: var(--color-roast-500);"
    >
      Precios expresados en USD. El switcher en la esquina superior muestra el equivalente en bolívares a tasa BCV.
    </p>
  </div>
</section>
