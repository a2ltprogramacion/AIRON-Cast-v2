---
import testimonialsData from '../content/testimonials.json';
---

<section
  id="testimonios"
  class="section-y"
  style="background-color: var(--color-bg-paper);"
>
  <div class="container-cenit">
    <div class="text-center mb-12 md:mb-16 reveal">
      <span
        class="inline-block text-xs font-semibold uppercase tracking-widest mb-3"
        style="color: var(--color-ember-600);"
      >
        Confianza
      </span>
      <h2
        class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold max-w-3xl mx-auto"
        style="color: var(--color-roast-900);"
      >
        Lo que dicen nuestros clientes
      </h2>
    </div>

    <div class="grid md:grid-cols-3 gap-6 md:gap-8">
      {testimonialsData.testimonials.map((t) => (
        <article
          class="reveal flex flex-col p-8 md:p-10 rounded-2xl border"
          style="background-color: var(--color-bg-cream); border-color: var(--color-roast-100);"
        >
          <div class="flex items-center gap-1 mb-4" aria-label={`Calificación: ${t.rating} de 5 estrellas`}>
            {Array.from({ length: t.rating }).map(() => (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="currentColor"
                style="color: var(--color-ember-500);"
                aria-hidden="true"
              >
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
              </svg>
            ))}
          </div>

          <blockquote
            class="flex-1 text-base leading-relaxed italic mb-6"
            style="color: var(--color-roast-700);"
          >
            "{t.text}"
          </blockquote>

          <footer
            class="pt-4 border-t"
            style="border-color: var(--color-roast-100);"
          >
            <p
              class="text-sm font-semibold"
              style="color: var(--color-roast-900);"
            >
              — {t.name}
            </p>
            <p
              class="text-xs mt-0.5"
              style="color: var(--color-roast-500);"
            >
              {t.city}
            </p>
          </footer>
        </article>
      ))}
    </div>

    <p
      class="text-center text-xs mt-8 italic"
      style="color: var(--color-ember-600);"
    >
      ⓘ Los testimonios son placeholders — Carlos los reemplazará con citas reales de clientes.
    </p>
  </div>
</section>
