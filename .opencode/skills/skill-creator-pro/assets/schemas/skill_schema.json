{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
        },
        "description": {
            "type": "string",
            "minLength": 50
        },
        "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "type": {
            "type": "string",
            "enum": [
                "backend",
                "frontend",
                "integration",
                "utility"
            ]
        },
        "assigned_agents": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "minItems": 1
        },
        "scope": {
            "type": "string",
            "enum": [
                "restricted",
                "elevated"
            ]
        },
        "triggers": {
            "type": "object",
            "properties": {
                "primary": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "secondary": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "context": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "dependencies": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "version": {
                        "type": "string"
                    },
                    "optional": {
                        "type": "boolean"
                    }
                }
            }
        },
        "structure": {
            "type": "object",
            "additionalProperties": {
                "type": "string"
            }
        },
        "content": {
            "type": "object",
            "additionalProperties": {
                "type": "string"
            }
        }
    },
    "required": [
        "name",
        "description",
        "version",
        "type",
        "assigned_agents",
        "scope",
        "structure",
        "content"
    ]
}