---
import siteData from '../content/site.json';

const socialLinks = [
  { name: 'Instagram', url: siteData.instagram, icon: 'M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z' },
  { name: 'WhatsApp', url: `https://wa.me/${siteData.whatsapp.replace(/[^\d]/g, '')}`, icon: 'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347' },
];

const navLinks = [
  { label: 'Inicio', href: '#inicio' },
  { label: 'Proceso', href: '#proceso' },
  { label: 'Cafés', href: '#cafes' },
  { label: 'Testimonios', href: '#testimonios' },
  { label: 'Contacto', href: '#contacto' },
];
---

<footer
  class="py-12 md:py-16"
  style="background-color: var(--color-roast-900); color: var(--color-cream-soft);"
>
  <div class="container-cenit">
    <div class="grid md:grid-cols-4 gap-10 mb-10">
      <div class="md:col-span-1">
        <div class="text-2xl font-heading font-bold mb-3" style="color: white;">
          Café <span style="color: var(--color-ember-500);">Cenit</span>
        </div>
        <p class="text-sm leading-relaxed" style="color: var(--color-roast-300);">
          Tostado a pedido, siempre. Origen único venezolano.
        </p>
      </div>

      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider mb-4" style="color: white;">
          Navegación
        </h3>
        <ul class="space-y-2">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm hover:opacity-70 transition-opacity"
                style="color: var(--color-roast-300);"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider mb-4" style="color: white;">
          Contacto
        </h3>
        <ul class="space-y-2 text-sm" style="color: var(--color-roast-300);">
          <li>
            <a
              href={`https://wa.me/${siteData.whatsapp.replace(/[^\d]/g, '')}`}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:opacity-70 transition-opacity"
            >
              {siteData.whatsapp_display}
            </a>
          </li>
          <li>
            <a
              href={`mailto:${siteData.email}`}
              class="hover:opacity-70 transition-opacity"
            >
              {siteData.email}
            </a>
          </li>
          <li>{siteData.city}, {siteData.country}</li>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider mb-4" style="color: white;">
          Seguinos
        </h3>
        <div class="flex gap-3">
          {socialLinks.map((social) => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={social.name}
              class="w-10 h-10 rounded-full flex items-center justify-center transition-all hover:-translate-y-0.5"
              style="background-color: rgba(245, 239, 230, 0.08); color: var(--color-cream-soft);"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d={social.icon} />
              </svg>
            </a>
          ))}
        </div>
      </div>
    </div>

    <div
      class="pt-6 border-t flex flex-col md:flex-row justify-between items-center gap-3 text-xs"
      style="border-color: rgba(245, 239, 230, 0.12); color: var(--color-roast-300);"
    >
      <p>© {new Date().getFullYear()} Café Cenit. Todos los derechos reservados.</p>
      <p>
        Designed by
        <a
          href="https://a2lt.netlify.app"
          target="_blank"
          rel="noopener noreferrer"
          class="font-semibold hover:opacity-70 transition-opacity"
          style="color: var(--color-ember-300);"
        >A2LT Soluciones</a>
      </p>
    </div>
  </div>
</footer>
