---
import siteData from '../content/site.json';

const whatsappUrl = `https://wa.me/${siteData.whatsapp.replace(/[^\d]/g, '')}?text=${encodeURIComponent('Hola Café Cenit, vi la página y quiero conocer más sobre los cafés.')}`;
---

<section
  id="inicio"
  class="relative min-h-[100svh] flex items-center pt-24 pb-16 md:pt-32 md:pb-24 overflow-hidden grain-bg"
  style="background-color: var(--color-bg-cream);"
>
  <div class="container-cenit grid lg:grid-cols-12 gap-8 lg:gap-12 items-center relative z-10">
    <div class="lg:col-span-7 reveal">
      <span
        class="inline-flex items-center gap-2 px-3 py-1.5 mb-6 text-xs font-semibold rounded-full border"
        style="background-color: var(--color-ember-100); color: var(--color-ember-700); border-color: var(--color-ember-300);"
      >
        <span class="w-1.5 h-1.5 rounded-full" style="background-color: var(--color-ember-500);"></span>
        Tostado a pedido
      </span>

      <h1
        class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-heading font-bold leading-[1.05] mb-6"
        style="color: var(--color-roast-900);"
      >
        Café tostado cuando lo pedís.
        <span style="color: var(--color-ember-500);">Ni un día antes.</span>
      </h1>

      <p
        class="text-lg md:text-xl mb-8 max-w-2xl leading-relaxed"
        style="color: var(--color-roast-700);"
      >
        Origen único venezolano, empacado al vacío el mismo día del tueste.
        Recién hecho, con la frescura intacta, hasta la puerta de tu casa.
      </p>

      <div class="flex flex-col sm:flex-row gap-4">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-6 py-4 md:px-8 md:py-4 text-base font-semibold rounded-full transition-all hover:-translate-y-1 shadow-lg hover:shadow-xl"
          style="background-color: var(--color-ember-500); color: white;"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          Pedir por WhatsApp
        </a>
        <a
          href="#cafes"
          class="inline-flex items-center justify-center gap-2 px-6 py-4 md:px-8 md:py-4 text-base font-semibold rounded-full transition-all hover:-translate-y-1 border-2"
          style="background-color: transparent; color: var(--color-roast-900); border-color: var(--color-roast-300);"
        >
          Ver los cafés
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
      </div>

      <div
        class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm"
        style="color: var(--color-roast-700);"
      >
        <span class="inline-flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-ember-500);" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          Origen único
        </span>
        <span class="inline-flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-ember-500);" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          Tueste fresco
        </span>
        <span class="inline-flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-ember-500);" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          Envío inmediato
        </span>
      </div>
    </div>

    <div class="lg:col-span-5 reveal">
      <div class="relative aspect-[4/5] lg:aspect-[3/4] rounded-3xl overflow-hidden shadow-2xl" style="background-color: var(--color-roast-100);">
        <img
          src="https://images.unsplash.com/photo-1559056199-641a0ac8b55e?w=800&h=1000&fit=crop&q=80"
          alt="Granos de café tostado artesanalmente"
          class="w-full h-full object-cover"
          loading="eager"
          data-provisional="true"
        />
        <div
          class="absolute bottom-4 left-4 right-4 px-4 py-3 rounded-2xl backdrop-blur-md"
          style="background-color: rgba(59, 36, 23, 0.85);"
        >
          <p class="text-xs font-semibold uppercase tracking-wider" style="color: var(--color-ember-300);">
            Tueste de hoy
          </p>
          <p class="text-sm mt-1" style="color: var(--color-cream-soft);">
            Despachamos en menos de 24h después de tostar.
          </p>
        </div>
      </div>
      <p class="text-xs mt-2 italic text-center" style="color: var(--color-roast-500);">
        [Imagen provisional — reemplazar con foto real del proceso]
      </p>
    </div>
  </div>
</section>
