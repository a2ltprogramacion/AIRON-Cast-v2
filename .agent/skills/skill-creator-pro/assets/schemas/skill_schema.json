{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "name": {
            "type": "string",
            "pattern": "^[a-z0-0-]+$"
        },
        "description": {
            "type": "string",
            "minLength": 50
        },
        "structure": {
            "type": "object",
            "additionalProperties": {
                "type": "string"
            }
        },
        "content": {
            "type": "object",
            "additionalProperties": {
                "type": "string"
            }
        }
    },
    "required": [
        "name",
        "description",
        "structure",
        "content"
    ]
}