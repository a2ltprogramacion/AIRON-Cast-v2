---
import products from '../data/products.json';

// Extraer categorías únicas
const categories = Array.from(new Set(products.map(p => p.category)));

// Función para obtener icono por categoría de Bootstrap Icons
function getCategoryIcon(cat: string) {
  if (cat.includes('Ventilador')) return 'bi-wind';
  if (cat.includes('pozo') || cat.includes('Lápiz') || cat.includes('periférica') || cat.includes('centrífuga')) return 'bi-droplet-half';
  if (cat.includes('solar') || cat.includes('Paneles') || cat.includes('Lámpara solar')) return 'bi-sun-fill';
  if (cat.includes('piscina') || cat.includes('Filtro')) return 'bi-water';
  if (cat.includes('Hidrojet')) return 'bi-speedometer2';
  if (cat.includes('fuera de borda')) return 'bi-tsunami';
  if (cat.includes('Compresor')) return 'bi-gear-wide-connected';
  if (cat.includes('soldar')) return 'bi-lightning-charge-fill';
  if (cat.includes('Gato') || cat.includes('Graser') || cat.includes('dado') || cat.includes('Transpaleta')) return 'bi-tools';
  if (cat.includes('Jardinería') || cat.includes('Fumigación')) return 'bi-tree-fill';
  if (cat.includes('portón')) return 'bi-door-open-fill';
  if (cat.includes('Generador') || cat.includes('Planta')) return 'bi-plug-fill';
  if (cat.includes('Balanza') || cat.includes('Romana')) return 'bi-reception-4';
  if (cat.includes('Contadora') || cat.includes('Detectora')) return 'bi-cash-coin';
  if (cat.includes('Cocina') || cat.includes('Molino') || cat.includes('Licuadora') || cat.includes('alimento') || cat.includes('helado') || cat.includes('hielo')) return 'bi-cup-hot-fill';
  if (cat.includes('odontológico')) return 'bi-heart-pulse-fill';
  return 'bi-box-seam-fill';
}
---

<section class="catalog-section" id="catalogo">
  <div class="container">
    <div class="catalog-header">
      <div>
        <h2 class="section-title">Catálogo Completo de Equipos</h2>
        <p class="section-subtitle">Explora más de 190 productos industriales, solares y comerciales con stock en tienda.</p>
      </div>

      <!-- BUSCADOR Y SELECTOR DE CANTIDAD AL LADO DERECHO (EN LA MISMA LÍNEA) -->
      <div class="search-and-perpage">
        <div class="search-box">
          <i class="bi bi-search search-icon"></i>
          <input type="text" id="catalog-search" placeholder="Buscar por nombre, SKU o modelo..." onkeyup="filterCatalog()" />
        </div>

        <div class="perpage-box">
          <label for="per-page-select" class="perpage-lbl"><i class="bi bi-grid-3x3"></i> Mostrar:</label>
          <select id="per-page-select" class="perpage-select" onchange="changePerPage(this.value)">
            <option value="12" selected>12</option>
            <option value="20">20</option>
            <option value="52">52</option>
            <option value="100">100</option>
          </select>
        </div>
      </div>
    </div>

    <!-- SELECTOR DE CATEGORÍAS -->
    <div class="categories-wrapper">
      <button class="cat-pill active" onclick="selectCategory('all', this)">
        <i class="bi bi-grid-fill"></i> <span>Todas ({products.length})</span>
      </button>
      {categories.map(cat => {
        const count = products.filter(p => p.category === cat).length;
        const iconClass = getCategoryIcon(cat);
        return (
          <button class="cat-pill" onclick={`selectCategory('${cat}', this)`}>
            <i class={`bi ${iconClass}`}></i> <span>{cat} ({count})</span>
          </button>
        );
      })}
    </div>

    <!-- GRID DE PRODUCTOS -->
    <div class="products-grid" id="products-grid">
      {products.map(p => {
        const whatsappMsg = encodeURIComponent(
          `Hola G3 Multistore 👋, me interesa consultar el producto: *${p.title}* (SKU: ${p.sku}) por un monto de $${p.price_usd} (Divisas) / $${p.price_bcv} (BCV).`
        );
        return (
          <div 
            class="product-card" 
            data-category={p.category}
            data-title={p.title.toLowerCase()}
            data-sku={p.sku.toLowerCase()}
            data-stock={p.in_stock ? "true" : "false"}
          >
            <div class="product-top">
              <span class="sku-badge">{p.sku}</span>
              {p.in_stock ? (
                <span class="stock-badge in-stock"><i class="bi bi-check-circle-fill"></i> Disponible</span>
              ) : (
                <span class="stock-badge out-stock"><i class="bi bi-exclamation-triangle-fill"></i> AGOTADO</span>
              )}
            </div>

            <div class="product-body">
              <span class="category-tag">{p.subcategory || p.category}</span>
              <h3 class="product-title">{p.title}</h3>
              {p.specs && <p class="product-specs">{p.specs}</p>}
            </div>

            <div class="product-footer">
              <div class="prices-container">
                <div class="price-usd-display">
                  <span class="price-val">${p.price_usd}</span>
                  <span class="price-lbl">Divisas ($)</span>
                </div>
                <div class="price-bcv-display" style="display: none;">
                  <span class="price-val" style="color: var(--bcv);">${p.price_bcv}</span>
                  <span class="price-lbl">Tasa BCV</span>
                </div>
              </div>

              <a 
                href={`https://wa.me/584121869211?text=${whatsappMsg}`} 
                target="_blank" 
                class={`btn ${p.in_stock ? 'btn-whatsapp' : 'btn-outline'}`}
                style="padding: 8px 14px; font-size: 0.85rem;"
              >
                {p.in_stock ? (
                  <><i class="bi bi-whatsapp"></i> Cotizar</>
                ) : (
                  <><i class="bi bi-clock-history"></i> Consultar Llegada</>
                )}
              </a>
            </div>
          </div>
        );
      })}
    </div>
    
    <!-- BARRA DE PAGINACIÓN NUMERADA -->
    <div class="catalog-pagination-bar" id="catalog-pagination-bar">
      <div class="pagination-info" id="pagination-info">
        Mostrando 1 - 20 de 191 productos
      </div>
      <div class="pagination-controls" id="pagination-controls">
        <!-- Generados dinámicamente -->
      </div>
    </div>

    <div id="no-results" style="display:none; text-align:center; padding: 40px; color: var(--text-muted);">
      <i class="bi bi-inbox" style="font-size: 2rem; display:block; margin-bottom:8px;"></i>
      No se encontraron productos que coincidan con la búsqueda.
    </div>
  </div>
</section>

<style>
  .catalog-section {
    padding: 60px 0;
  }
  .catalog-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }
  .section-title {
    font-size: 1.85rem;
    color: var(--text);
    margin-bottom: 4px;
  }
  .section-subtitle {
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .search-and-perpage {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: nowrap;
  }
  .perpage-box {
    display: flex;
    align-items: center;
    gap: 6px;
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 10px 12px;
    border-radius: 8px;
    white-space: nowrap;
    height: 42px;
    box-sizing: border-box;
  }
  .perpage-lbl {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 4px;
    cursor: pointer;
  }
  .perpage-select {
    border: none;
    outline: none;
    background: transparent;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--primary);
    cursor: pointer;
  }

  .search-box {
    position: relative;
    width: 280px;
  }
  .search-icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  .search-box input {
    width: 100%;
    height: 42px;
    padding: 0 14px 0 38px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    font-size: 0.9rem;
    outline: none;
    transition: all 0.2s ease;
    box-sizing: border-box;
  }
  .search-box input:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px var(--primary-glow);
  }

  @media (max-width: 768px) {
    .catalog-header {
      flex-direction: column;
      align-items: stretch;
    }
    .search-and-perpage {
      width: 100%;
    }
    .search-box {
      flex: 1;
      width: auto;
    }
  }

  /* CATEGORÍAS EN HORIZONTAL */
  .categories-wrapper {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 12px;
    margin-bottom: 30px;
    scrollbar-width: thin;
  }
  .cat-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border-radius: 9999px;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
  }
  .cat-pill:hover {
    border-color: #cbd5e1;
    background: var(--surface-alt);
  }
  .cat-pill.active {
    background: var(--primary);
    color: #fff;
    border-color: var(--primary);
    box-shadow: 0 2px 8px rgba(37, 99, 235, 0.25);
  }

  /* GRID DE TARJETAS */
  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
    margin-bottom: 40px;
  }
  .product-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 14px;
    transition: all 0.2s ease;
  }
  .product-card:hover {
    border-color: #cbd5e1;
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.06);
    transform: translateY(-2px);
  }
  .product-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .sku-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    font-weight: 600;
    background: var(--surface-alt);
    color: var(--text-muted);
    padding: 3px 8px;
    border-radius: 4px;
  }
  .stock-badge {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 9999px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .stock-badge.in-stock {
    background: rgba(16, 185, 129, 0.1);
    color: var(--success);
  }
  .stock-badge.out-stock {
    background: rgba(239, 68, 68, 0.1);
    color: var(--danger);
  }

  .product-body {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .category-tag {
    font-size: 0.72rem;
    color: var(--primary);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .product-title {
    font-size: 1.05rem;
    color: var(--text);
    line-height: 1.35;
  }
  .product-specs {
    font-size: 0.82rem;
    color: var(--text-muted);
    line-height: 1.45;
  }

  .product-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--border);
    padding-top: 12px;
    gap: 10px;
  }
  .prices-container {
    display: flex;
    flex-direction: column;
  }
  .price-val {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--text);
    font-family: 'Plus Jakarta Sans', sans-serif;
  }
  .price-lbl {
    font-size: 0.7rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  /* BARRA DE PAGINACIÓN MODERNA Y ELEGANTE */
  .catalog-pagination-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #FFFFFF;
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 16px 24px;
    gap: 16px;
    flex-wrap: wrap;
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.05);
    margin-top: 10px;
  }
  .pagination-info {
    font-size: 0.92rem;
    color: var(--text-muted);
    font-weight: 500;
  }
  .pagination-info strong {
    color: var(--text);
    font-weight: 700;
  }
  .pagination-controls {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .page-btn {
    min-width: 42px;
    height: 42px;
    padding: 0 14px;
    border-radius: 12px;
    border: 1.5px solid transparent;
    background: #F1F5F9;
    color: #1E293B;
    font-weight: 700;
    font-size: 0.95rem;
    font-family: 'Plus Jakarta Sans', sans-serif;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    outline: none;
    user-select: none;
  }
  .page-btn:hover:not(:disabled) {
    background: rgba(37, 99, 235, 0.1);
    color: #2563EB;
    border-color: rgba(37, 99, 235, 0.25);
    transform: translateY(-2px);
  }
  .page-btn.active {
    background: #2563EB !important;
    color: #FFFFFF !important;
    border-color: #2563EB !important;
    box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);
    transform: translateY(-1px);
  }
  .page-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
    background: #F8FAFC;
    border-color: var(--border);
    color: var(--text-muted);
  }
  .page-ellipsis {
    color: var(--text-muted);
    font-weight: 700;
    font-size: 1.1rem;
    padding: 0 6px;
    user-select: none;
  }
</style>

<script is:inline>
  let activeCat = 'all';
  let currentPage = 1;
  let perPage = 12;
  let matchingCards = [];

  function selectCategory(cat, btn) {
    activeCat = cat;
    currentPage = 1;
    document.querySelectorAll('.cat-pill').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    filterCatalog();
  }

  function changePerPage(val) {
    perPage = parseInt(val, 10);
    currentPage = 1;
    renderCurrentPage();
  }

  function filterCatalog() {
    const q = document.getElementById('catalog-search')?.value.toLowerCase().trim() || '';
    const cards = Array.from(document.querySelectorAll('.product-card'));
    matchingCards = [];

    cards.forEach(card => {
      const cardCat = card.getAttribute('data-category');
      const title = card.getAttribute('data-title');
      const sku = card.getAttribute('data-sku');

      const matchesCat = (activeCat === 'all' || cardCat === activeCat);
      const matchesSearch = !q || title.includes(q) || sku.includes(q);

      if (matchesCat && matchesSearch) {
        matchingCards.push(card);
      } else {
        card.style.display = 'none';
      }
    });

    renderCurrentPage();
  }

  function goToPage(p) {
    currentPage = p;
    renderCurrentPage();
    document.getElementById('catalogo')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function renderCurrentPage() {
    const total = matchingCards.length;
    const totalPages = Math.max(1, Math.ceil(total / perPage));
    if (currentPage > totalPages) currentPage = totalPages;

    const startIdx = (currentPage - 1) * perPage;
    const endIdx = startIdx + perPage;

    matchingCards.forEach((card, idx) => {
      if (idx >= startIdx && idx < endIdx) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });

    // Actualizar texto info
    const info = document.getElementById('pagination-info');
    const pagBar = document.getElementById('catalog-pagination-bar');
    const noRes = document.getElementById('no-results');

    if (total === 0) {
      if (pagBar) pagBar.style.display = 'none';
      if (noRes) noRes.style.display = 'block';
      return;
    } else {
      if (pagBar) pagBar.style.display = 'flex';
      if (noRes) noRes.style.display = 'none';
    }

    const currentShownStart = startIdx + 1;
    const currentShownEnd = Math.min(total, endIdx);
    if (info) {
      info.innerHTML = `Mostrando <strong>${currentShownStart} - ${currentShownEnd}</strong> de <strong>${total}</strong> productos`;
    }

    // Renderizar botones de paginación
    const controls = document.getElementById('pagination-controls');
    if (!controls) return;

    let html = '';
    html += `<button class="page-btn" onclick="goToPage(${currentPage - 1})" ${currentPage <= 1 ? 'disabled' : ''}><i class="bi bi-chevron-left"></i></button>`;

    let startPage = Math.max(1, currentPage - 2);
    let endPage = Math.min(totalPages, startPage + 4);
    if (endPage - startPage < 4) {
      startPage = Math.max(1, endPage - 4);
    }

    if (startPage > 1) {
      html += `<button class="page-btn" onclick="goToPage(1)">1</button>`;
      if (startPage > 2) html += `<span class="page-ellipsis">…</span>`;
    }

    for (let p = startPage; p <= endPage; p++) {
      html += `<button class="page-btn ${p === currentPage ? 'active' : ''}" onclick="goToPage(${p})">${p}</button>`;
    }

    if (endPage < totalPages) {
      if (endPage < totalPages - 1) html += `<span class="page-ellipsis">…</span>`;
      html += `<button class="page-btn" onclick="goToPage(${totalPages})">${totalPages}</button>`;
    }

    html += `<button class="page-btn" onclick="goToPage(${currentPage + 1})" ${currentPage >= totalPages ? 'disabled' : ''}><i class="bi bi-chevron-right"></i></button>`;

    controls.innerHTML = html;
  }

  // Inicializar al cargar el DOM
  document.addEventListener('DOMContentLoaded', () => {
    filterCatalog();
  });
  // Fallback si ya cargó
  filterCatalog();
</script>
