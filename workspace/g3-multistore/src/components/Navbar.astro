---
---
<header class="navbar">
  <div class="container nav-content">
    <div class="brand">
      <span class="logo-badge">G3</span>
      <div class="brand-text">
        <span class="brand-name">MULTISTORE</span>
        <span class="brand-tag">San Diego · Carabobo</span>
      </div>
    </div>

    <!-- SWITCHER DE MONEDA -->
    <div class="currency-box">
      <span class="currency-label">Ver Precios:</span>
      <div class="currency-toggle">
        <button id="btn-curr-usd" class="curr-btn active" onclick="setCurrency('usd')">
          💵 Divisas ($)
        </button>
        <button id="btn-curr-bcv" class="curr-btn" onclick="setCurrency('bcv')">
          🏛️ Tasa BCV
        </button>
      </div>
    </div>

    <div class="nav-actions">
      <a href="https://wa.me/584121869211?text=Hola%20G3%20Multistore%20👋%2C%20quisiera%20solicitar%20asesor%C3%ADa%20y%20precios." target="_blank" class="btn btn-whatsapp">
        <span>💬</span> <span>WhatsApp</span>
      </a>
    </div>
  </div>
</header>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
    padding: 12px 0;
  }
  .nav-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }
  .logo-badge {
    background: var(--primary);
    color: white;
    font-weight: 800;
    font-size: 1.25rem;
    padding: 6px 12px;
    border-radius: 8px;
    letter-spacing: -0.05em;
  }
  .brand-text {
    display: flex;
    flex-direction: column;
  }
  .brand-name {
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    color: var(--text);
  }
  .brand-tag {
    font-size: 0.72rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .currency-box {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--surface-alt);
    padding: 4px 6px;
    border-radius: 10px;
    border: 1px solid var(--border);
  }
  .currency-label {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-muted);
    padding-left: 6px;
  }
  .currency-toggle {
    display: flex;
    gap: 4px;
  }
  .curr-btn {
    padding: 6px 12px;
    border-radius: 6px;
    border: none;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    background: transparent;
    color: var(--text-muted);
    transition: all 0.2s ease;
  }
  .curr-btn.active {
    background: var(--surface);
    color: var(--primary);
    box-shadow: 0 1px 4px rgba(0,0,0,0.08);
  }

  @media (max-width: 768px) {
    .currency-label { display: none; }
  }
</style>

<script is:inline>
  let currentCurrency = 'usd';

  function setCurrency(curr) {
    currentCurrency = curr;
    document.getElementById('btn-curr-usd')?.classList.toggle('active', curr === 'usd');
    document.getElementById('btn-curr-bcv')?.classList.toggle('active', curr === 'bcv');

    document.querySelectorAll('.price-usd-display').forEach(el => {
      el.style.display = curr === 'usd' ? 'block' : 'none';
    });
    document.querySelectorAll('.price-bcv-display').forEach(el => {
      el.style.display = curr === 'bcv' ? 'block' : 'none';
    });
  }
</script>
