---
import siteData from '../content/site.json';

const whatsappUrl = `https://wa.me/${siteData.whatsapp.replace(/[^\d]/g, '')}?text=${encodeURIComponent('Hola Café Cenit, quiero más información.')}`;
---

<section
  id="contacto"
  class="section-y"
  style="background-color: var(--color-bg-cream);"
>
  <div class="container-cenit">
    <div class="text-center mb-12 md:mb-16 reveal">
      <span
        class="inline-block text-xs font-semibold uppercase tracking-widest mb-3"
        style="color: var(--color-ember-600);"
      >
        Contacto
      </span>
      <h2
        class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold max-w-3xl mx-auto"
        style="color: var(--color-roast-900);"
      >
        Pedinos o preguntanos lo que quieras
      </h2>
    </div>

    <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
      <form
        class="reveal p-8 md:p-10 rounded-2xl border"
        style="background-color: var(--color-bg-paper); border-color: var(--color-roast-100);"
        action={`mailto:${siteData.email}`}
        method="post"
        enctype="text/plain"
      >
        <div class="mb-5">
          <label
            for="name"
            class="block text-sm font-semibold mb-2"
            style="color: var(--color-roast-700);"
          >
            Nombre
          </label>
          <input
            type="text"
            id="name"
            name="name"
            required
            autocomplete="name"
            class="w-full px-4 py-3 rounded-xl border bg-white transition-all focus:outline-none focus:ring-2"
            style="border-color: var(--color-roast-100); color: var(--color-roast-900);"
            placeholder="Tu nombre"
          />
        </div>

        <div class="mb-5">
          <label
            for="email"
            class="block text-sm font-semibold mb-2"
            style="color: var(--color-roast-700);"
          >
            Email
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
            class="w-full px-4 py-3 rounded-xl border bg-white transition-all focus:outline-none focus:ring-2"
            style="border-color: var(--color-roast-100); color: var(--color-roast-900);"
            placeholder="tu@email.com"
          />
        </div>

        <div class="mb-6">
          <label
            for="message"
            class="block text-sm font-semibold mb-2"
            style="color: var(--color-roast-700);"
          >
            Mensaje
          </label>
          <textarea
            id="message"
            name="message"
            required
            rows="5"
            class="w-full px-4 py-3 rounded-xl border bg-white transition-all focus:outline-none focus:ring-2 resize-none"
            style="border-color: var(--color-roast-100); color: var(--color-roast-900);"
            placeholder="Contanos qué te interesa: cantidad, frecuencia, dudas sobre el tueste…"
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full px-6 py-4 text-base font-semibold rounded-full transition-all hover:-translate-y-0.5 shadow-md hover:shadow-lg inline-flex items-center justify-center gap-2"
          style="background-color: var(--color-ember-500); color: white;"
        >
          Enviar mensaje
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="22" y1="2" x2="11" y2="13"/>
            <polygon points="22 2 15 22 11 13 2 9 22 2"/>
          </svg>
        </button>

        <p
          class="text-xs mt-3 text-center"
          style="color: var(--color-roast-500);"
        >
          Al enviar, se abrirá tu cliente de email con el mensaje pre-cargado.
        </p>
      </form>

      <div class="reveal flex flex-col gap-6">
        <div
          class="flex-1 p-8 md:p-10 rounded-2xl flex flex-col justify-center items-center text-center"
          style="background-color: var(--color-roast-900); color: var(--color-cream-soft);"
        >
          <div
            class="w-16 h-16 rounded-full flex items-center justify-center mb-4 whatsapp-pulse"
            style="background-color: var(--color-whatsapp);"
            aria-hidden="true"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="white" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
          </div>
          <h3
            class="text-2xl md:text-3xl font-heading font-bold mb-3"
            style="color: white;"
          >
            ¿Preferís WhatsApp?
          </h3>
          <p class="text-base mb-6 max-w-md" style="color: var(--color-cream-soft);">
            Es lo que usa casi todo el mundo. Respondemos en menos de 24h,
            de lunes a sábado.
          </p>
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3.5 text-sm font-semibold rounded-full transition-all hover:-translate-y-0.5 shadow-lg"
            style="background-color: var(--color-whatsapp); color: white;"
          >
            Abrir WhatsApp
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="7" y1="17" x2="17" y2="7"/>
              <polyline points="7 7 17 7 17 17"/>
            </svg>
          </a>
        </div>

        <div
          class="p-6 rounded-2xl text-sm"
          style="background-color: var(--color-cream-soft); color: var(--color-roast-700);"
        >
          <p>
            <span class="font-semibold">Email:</span>
            <a href={`mailto:${siteData.email}`} class="underline hover:no-underline" style="color: var(--color-ember-600);">
              {siteData.email}
            </a>
          </p>
          <p class="mt-1">
            <span class="font-semibold">Ubicación:</span> {siteData.city}, {siteData.country}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
